# ========================================
# 生产环境配置文件模板
# 使用方法：复制此文件为 .env.production
# ⚠️ 生产环境请务必修改敏感信息
# ========================================

# 服务器配置
PORT=3000
NODE_ENV=production

# MongoDB 连接配置（生产环境）
# ⚠️ 请根据实际生产环境修改以下配置
MONGODB_HOST=your_production_mongodb_host
MONGODB_PORT=27017
MONGODB_DATABASE=myapp_prod

# MongoDB 认证配置（生产环境建议启用）
MONGODB_ENABLE_AUTH=true
MONGODB_USER=your_production_user
MONGODB_PASSWORD=your_production_password

# API 配置
API_RATE_LIMIT=100

# CORS 配置（生产环境指定具体域名）
# 多个域名用逗号分隔，如：https://example.com,https://www.example.com
CORS_ORIGIN=https://your-frontend-domain.com

# 日志配置（生产环境精简日志）
LOG_LEVEL=warn

# JWT 配置
# ⚠️ 生产环境必须修改为强密码
JWT_SECRET=your_strong_jwt_secret_key_here_change_this_in_production
JWT_EXPIRES_IN=24h