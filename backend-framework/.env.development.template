# ========================================
# 开发环境配置文件模板
# 使用方法：复制此文件为 .env.development
# ========================================

# 服务器配置
PORT=3000
NODE_ENV=development

# MongoDB 连接配置（本地开发）
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=framework_dev

# MongoDB 认证配置
MONGODB_ENABLE_AUTH=false
MONGODB_USER=
MONGODB_PASSWORD=

# API 配置
API_RATE_LIMIT=1000

# CORS 配置（开发环境允许所有来源）
CORS_ORIGIN=*

# 日志配置（开发环境详细日志）
LOG_LEVEL=debug

# JWT 配置
JWT_SECRET=dev_jwt_secret_key_for_development_only
JWT_EXPIRES_IN=24h