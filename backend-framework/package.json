{
  "name": "express-mongodb-template",
  "version": "1.0.0",
  "description": "A template project for Express + MongoDB + TypeScript backend",
  "main": "index.ts",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "cross-env NODE_ENV=development nodemon --exec ts-node index.ts",
    "dev:load-env": "dotenv -e .env.development -- nodemon --exec ts-node index.ts",
    "prod": "cross-env NODE_ENV=production ts-node index.ts",
    "prod:load-env": "dotenv -e .env.production -- ts-node index.ts",
    "build": "tsc",
    "serve": "node dist/index.js",
    "deploy": "bash deploy.sh",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:start:dev": "pm2 start ecosystem.config.js --env development",
    "pm2:stop": "pm2 stop express-mongodb-app",
    "pm2:restart": "pm2 restart express-mongodb-app",
    "pm2:logs": "pm2 logs express-mongodb-app",
    "pm2:status": "pm2 status",
    "env:setup": "node scripts/setup-env.js",
    "test:db": "node scripts/test-mongodb-connection.js",
    "test:db:dev": "dotenv -e .env.development -- node scripts/test-mongodb-connection.js",
    "test:db:prod": "dotenv -e .env.production -- node scripts/test-mongodb-connection.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.3.0",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
